# Copy to .env and fill in values. Never commit .env.

# PostgreSQL
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=trader
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MLflow (port 5555 avoids macOS AirPlay conflict on 5000)
MLFLOW_PORT=5555
MLFLOW_TRACKING_URI=http://localhost:5555

# pgAdmin (optional — only used with: docker compose --profile pgadmin up)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Zerodha Kite (live adapter — leave blank until live trading is enabled)
KITE_API_KEY=
KITE_API_SECRET=
KITE_REQUEST_TOKEN=

# Kaggle (for historical data backfill)
KAGGLE_USERNAME=
KAGGLE_KEY=
