# audit/P2 forward paper loop, IST (TZ set in the image). Two attempts a day:
# after NSE publishes (usually 18:30-19:30 IST), and a morning catch-up. Both
# are idempotent -- a run that finds nothing new exits in seconds.
0 21 * * * bash /app/scripts/paper_daily.sh
30 7 * * * bash /app/scripts/paper_daily.sh
# Second live book (owner, 2026-10-12): the P3 adaptive rules at live 09:16
# fills -- adaptive signal (scripts/adaptive_signal.py, stitched nightly at
# 21:40), rebalance on the 1st and 16th, same stop and costs. Its own Rs 1L in
# audit/paper/live_adaptive/, log logs/paper/live_adaptive_<date>.log.
17,21,31 9 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_adaptive TRADER_LIVE_SIGNAL=data/signal/adaptive_signal/predictions.parquet TRADER_LIVE_FREQ=semimonthly TRADER_LIVE_TAG=adaptive bash /app/scripts/live_paper_cron.sh trade
*/15 9-15 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_adaptive TRADER_LIVE_SIGNAL=data/signal/adaptive_signal/predictions.parquet TRADER_LIVE_FREQ=semimonthly TRADER_LIVE_TAG=adaptive bash /app/scripts/live_paper_cron.sh mark
36 15 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_adaptive TRADER_LIVE_SIGNAL=data/signal/adaptive_signal/predictions.parquet TRADER_LIVE_FREQ=semimonthly TRADER_LIVE_TAG=adaptive bash /app/scripts/live_paper_cron.sh mark --close
# Third live book (owner, 2026-10-16): P6, 12-1 momentum, 15 names, monthly
# (audit/P6_MOMENTUM_15.md). Signal is a plain price ratio rebuilt after each P2
# panel build; same allocator, stop and costs. Its own Rs 1L in
# audit/paper/live_momentum/, log logs/paper/live_momentum_<date>.log.
50 21 * * * cd /app && uv run python scripts/momentum_signal.py >> logs/paper/momentum_signal.log 2>&1
20 8 * * * cd /app && uv run python scripts/momentum_signal.py >> logs/paper/momentum_signal.log 2>&1
18,22,32 9 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_momentum TRADER_LIVE_SIGNAL=data/signal/momentum_12_1/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_TAG=momentum bash /app/scripts/live_paper_cron.sh trade
*/15 9-15 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_momentum TRADER_LIVE_SIGNAL=data/signal/momentum_12_1/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_TAG=momentum bash /app/scripts/live_paper_cron.sh mark
37 15 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_momentum TRADER_LIVE_SIGNAL=data/signal/momentum_12_1/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_TAG=momentum bash /app/scripts/live_paper_cron.sh mark --close
# Fourth live book (owner, 2026-10-18): P7, momentum + low vol + 52-week high,
# z-scored within sector, 15 names, monthly (audit/P7_COMPOSITE_15.md).
55 21 * * * cd /app && uv run python scripts/composite_signal.py >> logs/paper/composite_signal.log 2>&1
25 8 * * * cd /app && uv run python scripts/composite_signal.py >> logs/paper/composite_signal.log 2>&1
19,23,33 9 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_composite TRADER_LIVE_SIGNAL=data/signal/composite3/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_TAG=composite bash /app/scripts/live_paper_cron.sh trade
*/15 9-15 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_composite TRADER_LIVE_SIGNAL=data/signal/composite3/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_TAG=composite bash /app/scripts/live_paper_cron.sh mark
38 15 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_composite TRADER_LIVE_SIGNAL=data/signal/composite3/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_TAG=composite bash /app/scripts/live_paper_cron.sh mark --close
# Fifth live book (owner, 2026-10-19): P8, rising delivery %, z-scored within
# sector, 15 names, monthly (audit/P8_DELIVERY_15.md). Delivery data is merged
# into data/ext/delivery.parquet by delivery_update.py (fetch_nse_flows.py alone
# OVERWRITES its output for the range asked; never call it directly here). The
# update fetches through yesterday: NSE 404s are cached as permanent .missing
# markers, so today's file is never asked for before it exists.
30 21 * * * cd /app && uv run python scripts/delivery_update.py >> logs/paper/delivery_update.log 2>&1
15 8 * * * cd /app && uv run python scripts/delivery_update.py >> logs/paper/delivery_update.log 2>&1
58 21 * * * cd /app && uv run python scripts/delivery_signal.py >> logs/paper/delivery_signal.log 2>&1
28 8 * * * cd /app && uv run python scripts/delivery_signal.py >> logs/paper/delivery_signal.log 2>&1
20,24,34 9 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_delivery TRADER_LIVE_SIGNAL=data/signal/delivery_rise/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_TAG=delivery bash /app/scripts/live_paper_cron.sh trade
*/15 9-15 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_delivery TRADER_LIVE_SIGNAL=data/signal/delivery_rise/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_TAG=delivery bash /app/scripts/live_paper_cron.sh mark
39 15 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_delivery TRADER_LIVE_SIGNAL=data/signal/delivery_rise/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_TAG=delivery bash /app/scripts/live_paper_cron.sh mark --close
# Sixth live book (owner, 2026-10-19): P9 = Book 3 with a 10-session stop
# re-entry ban instead of 21 (audit/P9_MOMENTUM_15_CD10.md, from S7). Shares
# Book 3's momentum signal file, so it has no signal job of its own.
21,25,35 9 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_momentum10 TRADER_LIVE_SIGNAL=data/signal/momentum_12_1/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_COOLDOWN=10 TRADER_LIVE_TAG=momentum10 bash /app/scripts/live_paper_cron.sh trade
*/15 9-15 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_momentum10 TRADER_LIVE_SIGNAL=data/signal/momentum_12_1/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_COOLDOWN=10 TRADER_LIVE_TAG=momentum10 bash /app/scripts/live_paper_cron.sh mark
40 15 * * 1-5 TRADER_LIVE_DIR=audit/paper/live_momentum10 TRADER_LIVE_SIGNAL=data/signal/momentum_12_1/predictions.parquet TRADER_LIVE_K=15 TRADER_LIVE_FREQ=monthly TRADER_LIVE_COOLDOWN=10 TRADER_LIVE_TAG=momentum10 bash /app/scripts/live_paper_cron.sh mark --close
# Intraday Phase 0 (owner, 2026-10-18): DATA ONLY, no trading. Tick + 5-level
# depth recorder for ~230 liquid/held names (09:00-15:35; retried every 10 min so
# a late Kite login still gets the rest of the day; one instance via pid lock),
# and a forward-only NSE announcement log with our own first-seen time.
0,10,20,30,40,50 9-14 * * 1-5 bash /app/scripts/intraday_cron.sh recorder
*/15 7-23 * * * bash /app/scripts/intraday_cron.sh announcements
# P3 adaptive shadow book (audit/P3_ADAPTIVE_SHADOW.md): end-of-day replay after
# each P2 run. Separate script so it can never affect the P2 record; waits if
# P2 has not built today's panel. Refits themselves run on the host GPU.
40 21 * * * bash /app/scripts/adaptive_daily.sh
10 8 * * * bash /app/scripts/adaptive_daily.sh
# Health check 20 minutes after each run, so audit/paper/health.json is never
# older than a day and a silent failure shows up on the dashboard. Without this
# the file was only refreshed by hand (ops review, 2026-09-29).
20 21 * * * cd /app && uv run python scripts/paper_healthcheck.py
50 7 * * * cd /app && uv run python scripts/paper_healthcheck.py
# Live paper book (scripts/live_paper.py): Rs 1,00,000 deployed at 09:16 IST at
# live Kite prices, then marked every 15 minutes through the session and once
# after the close. Needs the daily Kite login; without a valid token each run
# logs the refusal and exits. `trade` = first funding / monthly rebalance /
# pending stops / hold, decided per day. Idempotent per day (state.json last_trade_day), so 09:20 and 09:30 are retries.
16,20,30 9 * * 1-5 bash /app/scripts/live_paper_cron.sh trade
*/15 9-15 * * 1-5 bash /app/scripts/live_paper_cron.sh mark
# Close mark: ticks stop cooldowns and flags volstop breaches for the next 09:16.
35 15 * * 1-5 bash /app/scripts/live_paper_cron.sh mark --close
