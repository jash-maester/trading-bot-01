# Normalisation stats emitted next to the panels by runner.py.
# The *.sha256 panel provenance sidecars ARE tracked — do not widen this.
data/panels/*_stats.json

# Docker volumes (local bind mounts if any)
pgdata/

# Secrets / env
.env
# Backups of secret-bearing files — never commit these.
.env.bak*
*.bak

# ledger.py / quantstats tearsheets. The hand-written .md reports ARE tracked.
reports/*.html
*.pem
*.key

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Hydra outputs
outputs/
multirun/

# Project-local docker config (training box credential-helper workaround)
.docker/
backups/
# Vendored third-party source for the Kronos spike (13_fundamentals_and_news.md
# section 2). Cloned by scripts/kronos_smoke.py's instructions, not ours to
# version.
/vendor/

# Training artefacts mirrored down from the box (2026-09-09). These are DATA:
# a Windows update took the box offline while it held the only copy of every
# point-in-time artefact, so they are now copied locally for redundancy -- but
# they must not enter git. `.git` is already 1.2 GB because r4_v1's checkpoints
# and its embeddings.npy were committed once; those stay tracked (ignoring does
# not untrack) but nothing new joins them.
data/ext/
data/bhav_ohlcv/
data/panels_bhav/
data/signal/r4_pit*/
*.npy
*.pt
